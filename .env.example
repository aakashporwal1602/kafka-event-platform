# ============================================================================
#  Kafka Event Platform — environment template
#  Copy to .env and adjust. NEVER commit a real .env.
#     cp .env.example .env
# ============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- Kafka ------------------------------------------------------------------
# From the HOST use the EXTERNAL listeners (localhost:1909x).
# From inside a container use the INTERNAL ones (kafka-N:9092).
KAFKA_BROKERS=localhost:19092,localhost:19093,localhost:19094
KAFKA_CLIENT_ID=event-platform
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# Connection tuning
KAFKA_CONNECTION_TIMEOUT_MS=3000
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_RETRY_INITIAL_TIME_MS=300
KAFKA_RETRY_MAX_ATTEMPTS=5

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_dev_only
POSTGRES_DB=event_platform
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=20

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=kep

# --- Observability ----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=event-platform
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
METRICS_PORT=9464

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Service ports ----------------------------------------------------------
GATEWAY_PORT=3000
PRODUCER_PORT=3010
SCHEMA_REGISTRY_PORT=3020
REPLAY_SERVICE_PORT=3030
DLQ_SERVICE_PORT=3040

# --- Platform behaviour -----------------------------------------------------
DEFAULT_PARTITION_COUNT=12
DEFAULT_REPLICATION_FACTOR=3
DEFAULT_MIN_INSYNC_REPLICAS=2
DEFAULT_RETENTION_MS=604800000
IDEMPOTENCY_TTL_SECONDS=86400
