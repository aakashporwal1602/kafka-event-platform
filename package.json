{
  "name": "kafka-event-platform",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "A production-grade internal event streaming platform built on Apache Kafka \u2014 reliable publish/consume, schema governance, tiered retries, DLQ, replay, and full observability.",
  "author": "Aakash Porwal <aakashporwal111@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --stream build",
    "typecheck": "tsc -b --pretty",
    "typecheck:clean": "tsc -b --clean && tsc -b --pretty",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "infra:nuke": "docker compose -f infra/docker/docker-compose.yml down -v",
    "topics:bootstrap": "pnpm --filter @platform/tools topics:bootstrap",
    "topics:plan": "pnpm --filter @platform/tools topics:plan",
    "cluster:verify": "pnpm --filter @platform/tools cluster:verify",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@platform/core": "workspace:*",
    "@platform/domain": "workspace:*",
    "@platform/kafka": "workspace:*",
    "@platform/persistence": "workspace:*",
    "@platform/producer": "workspace:*",
    "@testcontainers/kafka": "^10.13.2",
    "@testcontainers/postgresql": "^10.13.2",
    "@testcontainers/redis": "^10.13.2",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "^2.1.3",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.6",
    "kafkajs": "^2.2.4",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "testcontainers": "^10.13.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
